rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin() ||
        (signedIn() && resource.data.role == 'driver');
      allow create: if isSelf(uid) && request.resource.data.role in ['passenger','driver'];
      allow update: if signedIn() && (
        (isSelf(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name','photo','carMake','carModel','plate','experience','phone','profileComplete','status','location','locationUpdatedAt'])) ||
        (resource.data.role == 'driver' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ratingSum','ratingCount','ratingAvg']))
      );
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow create: if signedIn() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.status == 'requested';

      allow read: if signedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested' ||
        isAdmin()
        
      );

        allow update: if signedIn() && (
     isAdmin() ||
     resource.data.passengerId == request.auth.uid ||
     resource.data.driverId == request.auth.uid ||
     (resource.data.status == "requested"
       && request.resource.data.driverId == request.auth.uid
       && request.resource.data.driverId != resource.data.passengerId)
   );


      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if signedIn() && (
          get(/databases/$(database)/documents/rides/$(rideId)).data.passengerId == request.auth.uid ||
          get(/databases/$(database)/documents/rides/$(rideId)).data.driverId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
